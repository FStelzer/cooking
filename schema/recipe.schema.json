{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fstelzer.github.io/cooking/schema/recipe.schema.json",
  "title": "Rezept / Menü / Gang (v0.2, Phase 2b)",
  "description": "Kanonisches Zwischenformat. Markdown bleibt Quelle; verbatim-Felder tragen den Quelltext wortgleich, typisierte Felder sind Annotationen (Zitate) oder normalisierte Werte. Siehe SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]*$",
      "description": "Pfad der Quelldatei ohne .md, z. B. gerichte/thit-kho-trung"
    },
    "kind": {
      "enum": [
        "dish",
        "menu",
        "course",
        "guide"
      ]
    },
    "title": {
      "type": "string",
      "description": "H1 ohne 🚧, verbatim"
    },
    "status": {
      "enum": [
        "wip",
        "done"
      ],
      "default": "done"
    },
    "statusNote": {
      "$ref": "#/$defs/markdown"
    },
    "intro": {
      "$ref": "#/$defs/markdown",
      "description": "Kursive Meta-Zeile und Absätze vor der ersten ##, verbatim"
    },
    "yields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "active": {
          "$ref": "#/$defs/durationRange"
        },
        "total": {
          "$ref": "#/$defs/durationRange"
        }
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ingredient"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vom Generator (cli derive) geschrieben, nie von Hand. Einkaufsliste und Mengen-Check als abgeleitete Sichten (L10).",
      "required": [
        "generatedAt",
        "sourceHash",
        "quantities",
        "shopping"
      ],
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        },
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ingredient",
              "total",
              "perTask"
            ],
            "properties": {
              "ingredient": {
                "$ref": "#/$defs/slug"
              },
              "total": {
                "$ref": "#/$defs/amount"
              },
              "perTask": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "unitless": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unitMixed": {
                "type": "boolean"
              },
              "perCourse": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/amount"
                }
              }
            }
          }
        },
        "shopping": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "store",
              "items"
            ],
            "properties": {
              "store": {
                "type": "string"
              },
              "group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ingredient",
                    "name",
                    "need",
                    "display",
                    "inStock"
                  ],
                  "properties": {
                    "ingredient": {
                      "$ref": "#/$defs/slug"
                    },
                    "name": {
                      "type": "string"
                    },
                    "need": {
                      "$ref": "#/$defs/amount"
                    },
                    "buy": {
                      "$ref": "#/$defs/amount"
                    },
                    "priority": {
                      "type": "string"
                    },
                    "optional": {
                      "type": "boolean"
                    },
                    "pantry": {
                      "type": "boolean"
                    },
                    "display": {
                      "type": "string",
                      "description": "Menge als reiner Text für die Anzeige (Löffel-Regel), kein Markdown"
                    },
                    "note": {
                      "type": "string"
                    },
                    "inStock": {
                      "type": "boolean",
                      "description": "Autor-Angabe aus Ingredient.inStock. Abhak-Zustand beim Einkaufen ist Renderer-State (localStorage), nie Teil der Datei."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        }
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "serve"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/slug"
          },
          "n": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "serve": {
            "$ref": "#/$defs/offset"
          },
          "source": {
            "type": "string"
          },
          "after": {
            "$ref": "#/$defs/eventRef"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "examples": [
              "oven",
              "hob",
              "cook"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "persons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "adults": {
          "type": "integer"
        },
        "kids": {
          "type": "integer"
        },
        "guests": {
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "markdown": {
      "type": "string",
      "description": "Docsify-Markdown, verbatim aus der Quelle"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "not": {
        "pattern": "^[0-9]+$"
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
      "description": "ISO 8601. Konvention: PnD = Kalendertage, PTnH = Uhrzeit-Stunden (P1D ≠ PT24H)."
    },
    "durationRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/$defs/duration"
        },
        "max": {
          "$ref": "#/$defs/duration"
        },
        "typical": {
          "$ref": "#/$defs/duration"
        },
        "source": {
          "type": "string",
          "description": "Originalphrase, Zitat"
        },
        "estimated": {
          "type": "boolean",
          "description": "Dauer steht nicht in der Quelle, sondern ist geschätzt (L6: markiert)"
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "typical"
          ]
        }
      ]
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Span, wie er in der Quelle steht (Zahl + Einheit, ggf. + Nomen zur Eindeutigkeit)"
        },
        "value": {
          "type": "number"
        },
        "max": {
          "type": "number",
          "description": "Obergrenze bei Spannen"
        },
        "approx": {
          "type": "boolean"
        },
        "unit": {
          "type": "string",
          "examples": [
            "g",
            "kg",
            "ml",
            "l",
            "EL",
            "TL",
            "Prise",
            "Stück",
            "Bund",
            "Schuss",
            "cm",
            "%"
          ]
        },
        "per": {
          "type": "string",
          "examples": [
            "Pfanne",
            "Person",
            "Portion"
          ]
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "description": "Anzeige-Hinweis für die Kochansicht (z. B. 14,7 ml → 1 EL). Rohwert bleibt value/unit. Ohne display greift die Löffel-Heuristik (tools/recipes/spoons.py).",
          "properties": {
            "value": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "examples": [
                "EL",
                "TL"
              ]
            }
          }
        },
        "times": {
          "type": "integer",
          "minimum": 1,
          "description": "Vervielfacher für „je …“-Angaben: Gesamt = value × times"
        }
      },
      "dependentRequired": {
        "value": [
          "unit"
        ]
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "store"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string"
        },
        "prep": {
          "type": "string"
        },
        "note": {
          "$ref": "#/$defs/markdown",
          "description": "Kursive Anmerkung aus der Einkaufsliste (Marke, Preis, Fallback)"
        },
        "store": {
          "type": "string",
          "examples": [
            "Asialaden",
            "REWE Center",
            "Selgros",
            "Buhara Seafood",
            "Aldi / REWE",
            "Online",
            "Vorrat"
          ]
        },
        "group": {
          "type": "string",
          "description": "Warengruppe im Laden"
        },
        "storeNote": {
          "type": "string"
        },
        "buy": {
          "$ref": "#/$defs/amount",
          "description": "Kaufgebinde, wenn ≠ Bedarf"
        },
        "inStock": {
          "type": "boolean"
        },
        "pantry": {
          "type": "boolean",
          "description": "Kleinmengen-/Vorratsposten"
        },
        "priority": {
          "enum": [
            "pflicht",
            "empfohlen",
            "optional"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "fallback": {
          "type": "string"
        },
        "unitHint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "factor"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "factor": {
              "type": "number"
            }
          }
        },
        "scale": {
          "enum": [
            "linear",
            "fixed",
            "step",
            "note"
          ],
          "default": "linear"
        },
        "scaleNote": {
          "type": "string"
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Gang-Zuordnung (Menü), wie am Einkaufsposten vermerkt"
        }
      }
    },
    "stepIngredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "amount"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/slug"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1,
          "description": "n-tes Vorkommen von amount.text in step.text, wenn mehrdeutig"
        },
        "actionOccurrence": {
          "type": "integer",
          "minimum": 1
        },
        "spanForm": {
          "enum": [
            "exact",
            "derived"
          ],
          "default": "exact"
        },
        "reuse": {
          "type": "boolean",
          "description": "Zutat wurde schon in einem früheren Schritt dosiert; wird skaliert, aber nicht summiert"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "duration"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/$defs/durationRange"
        },
        "text": {
          "type": "string",
          "description": "Zitat"
        }
      }
    },
    "temp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "kern",
            "ofen",
            "halten",
            "max",
            "ziel"
          ]
        },
        "value": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "endCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "time",
            "temperature",
            "visual"
          ]
        },
        "value": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "text",
        "action",
        "ingredients"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "Stabiler Slug, nie aus der Nummer"
        },
        "label": {
          "type": "string",
          "description": "Anzeige-Nummer verbatim"
        },
        "heading": {
          "type": "string",
          "description": "Überschriftzeile des Schritts verbatim (inkl. Markdown-Marker), falls vorhanden"
        },
        "title": {
          "type": "string",
          "description": "Titel ohne Nummer und Dauer, Zitat aus heading"
        },
        "text": {
          "$ref": "#/$defs/markdown",
          "description": "Ganzer Schrittabsatz verbatim"
        },
        "action": {
          "type": "string",
          "description": "Kurzansicht: verbatim Präfix von text (ganze Sätze) oder mengenfreie Kurzfassung mit actionDerived"
        },
        "actionDerived": {
          "type": "boolean"
        },
        "attention": {
          "enum": [
            "active",
            "attended",
            "passive"
          ]
        },
        "duration": {
          "$ref": "#/$defs/durationRange"
        },
        "timers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timer"
          }
        },
        "temps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temp"
          }
        },
        "endCondition": {
          "$ref": "#/$defs/endCondition"
        },
        "ingredients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepIngredient"
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        },
        "rescue": {
          "type": "string"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technique": {
          "type": "string",
          "pattern": "^[a-z0-9/_-]+(\\.md)?#[a-z0-9-]+$"
        },
        "parallel": {
          "type": "boolean",
          "description": "Verbatim-Marker aus der Überschrift („parallel“). Planung leitet Parallelität aus `after` ab, nicht hieraus."
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepRef"
          },
          "description": "Schritte, die abgeschlossen sein müssen. Fehlt das Feld: der vorhergehende Schritt des Tasks. Leeres Array: keine Voraussetzung (kann jederzeit laufen)."
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "offset"
          ],
          "description": "Relativer Zeitanker: Start dieses Schritts relativ zu Start/Ende eines anderen (z. B. „letzte 20–30 Min. des Schmorens“).",
          "properties": {
            "ref": {
              "$ref": "#/$defs/eventRef"
            },
            "offset": {
              "$ref": "#/$defs/offsetRange"
            }
          }
        },
        "events": {
          "type": "array",
          "description": "Zeitpunkte innerhalb des Schritts (kein Timer): „nach ~60 Min. Eier wenden“.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "text"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/durationRange"
              },
              "text": {
                "type": "string",
                "description": "Zitat"
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "meta": {
          "type": "string",
          "description": "Kursive Meta-Zeile unter der Überschrift, verbatim (Quelle von after/start/claims/endCondition/technique)"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string"
        },
        "hold": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "oneOf": [
                {
                  "$ref": "#/$defs/duration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max": {
              "oneOf": [
                {
                  "$ref": "#/$defs/duration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ideal": {
              "$ref": "#/$defs/duration"
            },
            "source": {
              "type": "string"
            }
          },
          "description": "Haltbarkeitsfenster relativ zu product:ready (= Ende des erzeugenden Tasks): min = mindestens so lange ruhen, max = spätestens so lange vorher fertig."
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "place"
          ],
          "properties": {
            "place": {
              "enum": [
                "fridge",
                "freezer",
                "room",
                "warm",
                "oven"
              ]
            },
            "temp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              }
            },
            "covered": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string"
        },
        "intro": {
          "$ref": "#/$defs/markdown"
        },
        "phaseHint": {
          "type": "string",
          "description": "Verbatim-Slot wie „Vortag“; nie Hold, nie Dauer"
        },
        "duration": {
          "$ref": "#/$defs/durationRange"
        },
        "service": {
          "type": "boolean"
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^product:[a-z0-9][a-z0-9-]*$"
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "heading": {
          "type": "string",
          "description": "Label-Zeile des Komponentenblocks verbatim (z. B. „**Mango-Gel (bis 2 Tage vorher …):**“)"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(step|task|product):[a-z0-9-]+$",
          "description": "Optionaler Bezug; ohne ref gilt die Notiz dem ganzen Rezept/Menü"
        },
        "date": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])/20[0-9]{2}$"
        },
        "text": {
          "$ref": "#/$defs/markdown"
        },
        "status": {
          "enum": [
            "open",
            "applied"
          ]
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "markdown",
            "shopping",
            "tasks",
            "learnings",
            "todo",
            "courses",
            "schedule"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "markdown"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "markdown"
            ],
            "properties": {
              "type": {
                "const": "markdown"
              },
              "title": {
                "type": "string"
              },
              "level": {
                "enum": [
                  2,
                  3,
                  "bold"
                ],
                "default": 2
              },
              "markdown": {
                "$ref": "#/$defs/markdown"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "examples": [
                    "kind",
                    "schwangerschaft",
                    "beschaffung",
                    "quellen",
                    "notizen",
                    "teller-logik",
                    "fehlerbild",
                    "profi-tipps"
                  ]
                }
              },
              "collapsed": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shopping"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "title"
            ],
            "description": "Platzhalter: hier rendert der Renderer derived.shopping. Kein Inhalt in der Quelle nötig.",
            "properties": {
              "type": {
                "const": "shopping"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tasks"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "tasks"
            ],
            "properties": {
              "type": {
                "const": "tasks"
              },
              "title": {
                "type": "string"
              },
              "intro": {
                "$ref": "#/$defs/markdown"
              },
              "tasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/task"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "learnings"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "cooked",
              "summary"
            ],
            "properties": {
              "type": {
                "const": "learnings"
              },
              "title": {
                "type": "string"
              },
              "cooked": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^(0[1-9]|1[0-2])/20[0-9]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary": {
                "$ref": "#/$defs/markdown",
                "description": "Kurzfassung verbatim, beginnt mit **Gekocht MM/JJJJ.**"
              },
              "details": {
                "$ref": "#/$defs/markdown",
                "description": "Alles ab der ersten ###-Untersektion, verbatim"
              },
              "notes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/note"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "todo"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "items"
            ],
            "properties": {
              "type": {
                "const": "todo"
              },
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "checked"
                  ],
                  "properties": {
                    "text": {
                      "$ref": "#/$defs/markdown"
                    },
                    "checked": {
                      "type": "boolean"
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^(step|task|product):[a-z0-9-]+$"
                    }
                  }
                }
              },
              "intro": {
                "$ref": "#/$defs/markdown",
                "description": "Label-Zeile vor der Liste, verbatim (z. B. „**Offen (Testlauf):**“)"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "courses"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "courses"
            ],
            "properties": {
              "type": {
                "const": "courses"
              },
              "title": {
                "type": "string"
              },
              "intro": {
                "$ref": "#/$defs/markdown"
              },
              "courses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "schedule"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "schedule"
            ],
            "properties": {
              "type": {
                "const": "schedule"
              },
              "title": {
                "type": "string"
              },
              "intro": {
                "$ref": "#/$defs/markdown"
              },
              "note": {
                "$ref": "#/$defs/markdown",
                "description": "Prosa am Ende des Zeitplans (z. B. Ofen-Plan), verbatim"
              },
              "schedule": {
                "$ref": "#/$defs/schedule"
              }
            }
          }
        }
      ]
    },
    "offset": {
      "type": "string",
      "pattern": "^[+-]?P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
      "description": "Signierte ISO-8601-Dauer relativ zu einem Ereignis; negativ = davor."
    },
    "offsetRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/$defs/offset"
        },
        "max": {
          "$ref": "#/$defs/offset"
        },
        "typical": {
          "$ref": "#/$defs/offset"
        },
        "source": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "typical"
          ]
        }
      ]
    },
    "stepRef": {
      "type": "string",
      "pattern": "^step:[a-z0-9][a-z0-9-]*$"
    },
    "eventRef": {
      "type": "string",
      "pattern": "^(anchor|course:[a-z0-9][a-z0-9-]*:serve|task:[a-z0-9][a-z0-9-]*:(start|end)|step:[a-z0-9][a-z0-9-]*:(start|end)|product:[a-z0-9][a-z0-9-]*:ready|event:[a-z0-9][a-z0-9-]*)$",
      "description": "Ereignis für Anker und Constraints: anchor (Service-Anker), course:<id>:serve, task/step:<id>:start|end, product:<id>:ready (= Ende des erzeugenden Tasks), event:<id>."
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "examples": [
            "oven",
            "hob",
            "cook"
          ]
        },
        "units": {
          "type": "integer",
          "minimum": 1
        },
        "temp": {
          "type": "number"
        },
        "until": {
          "$ref": "#/$defs/eventRef",
          "description": "Belegung über das Step-Ende hinaus (Teller im Ofen bis Gang 3)"
        },
        "alt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "description": "Alternative Belegung („160 °C oder in der Pfanne“)"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "to",
        "value"
      ],
      "description": "Expliziter Abstand: to − from ≥ value (min-gap) bzw. ≤ value (max-gap). Sparsam einsetzen (< 5 pro Menü); Haltbarkeit gehört an Produkte.",
      "properties": {
        "type": {
          "enum": [
            "min-gap",
            "max-gap"
          ]
        },
        "from": {
          "$ref": "#/$defs/eventRef"
        },
        "to": {
          "$ref": "#/$defs/eventRef"
        },
        "value": {
          "$ref": "#/$defs/duration"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "day"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "description": "verbatim, z. B. „T-1“, „Gang 2 (+0:20)“"
        },
        "day": {
          "type": "integer",
          "description": "0 = Service-Tag, -1 = Vortag"
        },
        "part": {
          "enum": [
            "morning",
            "afternoon",
            "evening",
            "service"
          ]
        },
        "at": {
          "$ref": "#/$defs/offset",
          "description": "Lage relativ zum Anker, nur wenn die Quelle eine Zeit nennt"
        },
        "after": {
          "$ref": "#/$defs/eventRef",
          "description": "dokumentarisch: „Nach dem Amuse“"
        },
        "clock": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "description": "Uhrzeit der Phase („17:30 Uhr“); `at` ist daraus relativ zu anchor.time gerechnet"
        },
        "event": {
          "type": "string",
          "description": "verbatim, was die Phase markiert: „Gäste da“, „Nach dem Amuse“"
        }
      }
    },
    "scheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "text"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/slug"
        },
        "text": {
          "$ref": "#/$defs/markdown",
          "description": "Zeile bzw. ·-Abschnitt des Original-Zeitplans, verbatim"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Tasks, die dieser Eintrag abdeckt (leer = Logistik/Stub)"
        },
        "course": {
          "$ref": "#/$defs/slug"
        },
        "at": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "offset"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/eventRef"
            },
            "offset": {
              "$ref": "#/$defs/offset"
            }
          }
        },
        "order": {
          "type": "integer"
        },
        "derived": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Genauer: einzelne Schritte, wenn ein Task über mehrere Phasen läuft (Kaisergranat: auftauen T-1, auslösen vormittags)"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "phases",
        "entries"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "$ref": "#/$defs/slug"
        },
        "anchorOverride": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduleEntry"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "dish",
              "menu"
            ]
          }
        }
      },
      "then": {
        "required": [
          "yields",
          "ingredients"
        ]
      }
    }
  ]
}
